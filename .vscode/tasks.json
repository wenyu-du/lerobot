{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "Training_data",
            "type": "promptString",
            "description": "Please enter the training data's repo id"
        },        
        {
            "id": "singleTask",
            "type": "promptString",
            "description": "Please enter the task description",
            "default": "pick the black cable, then place into the fixture"
        },
        {
            "id": "DateSuffix",
            "type": "promptString",
            "description": "Please enter a date suffix (e.g., YYMMDDHHMM) for output directories and repo IDs.",
            "default": "$(date +%y%m%d%H%M)"
        },
        {
            "id": "PolicyPath",
            "type": "promptString",
            "description": "input the policy path for inference",
            "default": "/home/ae/project/lerobot/outputs/pi05_ae_260109_3/checkpoints/020000/pretrained_model"
        }
    ],
    "tasks": [
        {
            "label": "ae robot recording",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "src/lerobot/scripts/lerobot_record_aerobot.py",
                "--robot.type=bi_ae_robot",
                "--config_path=/home/ae/project/lerobot/src/lerobot/robots/ae_robot/comprehensive_aerobot_record_config.yaml",
                "--teleop.type=bi_spacemouse",
                "--dataset.single_task=${input:singleTask}",
                "--dataset.num_episodes=20",
                "--dataset.push_to_hub=true",
                "--dataset.episode_time_s=120",
                "--dataset.reset_time_s=1",
                "--dataset.fps=50",
                "--dataset.repo_id=wenyudu/demo_pi05_${input:DateSuffix}",
                "--display_data=true"
            ],
            "problemMatcher": [],
            "cwd": "/home/ae/project/lerobot",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "ae robot recording_test (without saving)",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "src/lerobot/scripts/lerobot_record_aerobot.py",
                "--robot.type=bi_ae_robot",
                "--config_path=/home/ae/project/lerobot/src/lerobot/robots/ae_robot/comprehensive_aerobot_record_config.yaml",
                "--teleop.type=bi_spacemouse",
                "--dataset.single_task=${input:singleTask}",
                "--dataset.num_episodes=1",
                "--dataset.push_to_hub=true",
                "--dataset.episode_time_s=10",
                "--dataset.reset_time_s=2",
                "--dataset.fps=50",
                "--dataset.inference_only=true",
                "--display_data=true",
                "--dataset.repo_id=wenyudu_test/demo_pi05_${input:DateSuffix}"
            ],
            "problemMatcher": [],
            "cwd": "/home/ae/project/lerobot",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "ae robot training",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "src/lerobot/scripts/lerobot_train.py",
                "--policy.type=pi05",
                "--output_dir=./outputs/pi05_ae_${input:DateSuffix}",
                "--job_name=pi05_ae_${input:DateSuffix}_training",
                "--policy.repo_id=wenyudu/pi05_ae_${input:DateSuffix}",
                "--policy.pretrained_path=/home/ae/.cache/huggingface/hub/models--lerobot--pi05_base/snapshots/9e50c659e8a0a6a3625d111044d1566672399e95",
                "--policy.compile_model=true",
                "--policy.gradient_checkpointing=true",
                "--wandb.enable=true",
                "--policy.dtype=bfloat16",
                "--steps=20000",
                "--policy.scheduler_decay_steps=20000",
                "--policy.device=cuda",
                "--batch_size=8",
                "--wandb.enable=true",
                "--dataset.repo_id=${input:Training_data}"
            ],
            "problemMatcher": [],
            "cwd": "/home/ae/project/lerobot"
        },
        {
            "label": "ae robot reference",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "src/lerobot/scripts/lerobot_record_aerobot.py",
                "--robot.type=bi_ae_robot",
                "--policy.path=${input:PolicyPath}",
                "--config_path=/home/ae/project/lerobot/src/lerobot/robots/ae_robot/comprehensive_aerobot_record_config.yaml",
                "--dataset.single_task=${input:singleTask}",
                "--dataset.num_episodes=10",
                "--dataset.push_to_hub=true",
                "--dataset.episode_time_s=120",
                "--interactive=true",
                "--dataset.reset_time_s=1",
                "--dataset.fps=10",
                "--dataset.repo_id=wenyudu/eval_pi05_${input:DateSuffix}",
                "--dataset.inference_only=true"
            ],
            "problemMatcher": [],
            "cwd": "/home/ae/project/lerobot"
        } 
    ]
}